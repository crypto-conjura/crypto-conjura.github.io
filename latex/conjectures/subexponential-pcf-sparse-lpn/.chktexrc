# chktex configuration for this conjecture. Run from this directory:
#
#     chktex -q -l .chktexrc statement.tex
#
# One warning is suppressed, checked hit by hit on 23 August 2026 rather
# than assumed, with a 100% false-positive rate here:
#
#   38  "You should not use punctuation in front of quotes." Every hit is
#       the final character of a sentence quoted verbatim from the source
#       paper -- a question mark, a full stop or the colon that ends
#       "Open Questions. We mention two interesting open questions:".
#       The punctuation belongs to the quoted text, so it stays inside
#       the quotation marks; moving it out would misquote the source.
#
# Everything else stays on. As of 23 August 2026 the file is clean under
# this config and `lacheck statement.tex` is silent.

CmdLine
{
    -n38
}
