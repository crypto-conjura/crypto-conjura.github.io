# chktex configuration for this conjecture. Run from this directory:
#
#     chktex -q -l .chktexrc statement.tex
#
# Two warnings are suppressed, checked hit by hit on 24 August 2026
# rather than assumed, each with a 100% false-positive rate here:
#
#   3   "You should enclose the previous parenthesis with `{}'." Fires
#       on $\{0,1\}^{n}$, where the superscript attaches to the closing
#       brace of literal set notation exactly as intended.
#   36  "You should put a space in front of parenthesis." Fires on
#       enumitem's own `label=(\alph*)' key-value syntax, where the
#       parenthesis is list-formatting syntax, not prose punctuation.
#
# Everything else stays on. As of 24 August 2026 the file is clean under
# this config and `lacheck statement.tex` is silent.

CmdLine
{
    -n3
    -n36
}
