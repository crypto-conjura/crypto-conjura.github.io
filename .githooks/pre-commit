#!/usr/bin/env bash
#
# Runs the cheap CI gates from .github/workflows/publish.yml before the commit
# is made, so a stale generated field fails here instead of failing every push
# afterwards.
#
# Why this exists: editing prose inside a `## Statement` block changes the text
# `scripts/status_badge.py` hashes into `statement_sha`. If the field is not
# regenerated, `--check` fails, and because that step gates the whole publish
# job, *every* subsequent push fails too -- not just the one that caused it.
# That happened on 2026-08-15 and blocked the site deploy for ~25 commits.
#
# Enable (once per clone):
#
#     git config core.hooksPath .githooks
#
# Bypass a single commit with `git commit --no-verify`.

set -uo pipefail

root="$(git rev-parse --show-toplevel)" || exit 0
cd "$root" || exit 0

# Only bother when the commit touches content these gates actually read.
# Nothing relevant staged (a .tex/.scss/.md-only commit) -> stay silent.
if ! git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^(c|p)/|\.qmd$|^scripts/|^_templates/'; then
  exit 0
fi

fail() {
  echo ""
  echo "pre-commit: $1" >&2
  echo "" >&2
  echo "  Fix, stage the result, and commit again:" >&2
  echo "    $2" >&2
  echo "" >&2
  echo "  To commit anyway: git commit --no-verify" >&2
  echo "" >&2
  exit 1
}

# --- gate 1: statement schema and badges -------------------------------------
# stdlib-only, so this one always runs.
if ! python3 scripts/status_badge.py --check c; then
  fail "statement schema/badge data is stale (CI gate 'status_badge.py --check c' would fail)." \
       "python3 scripts/status_badge.py"
fi

# --- gates 2 and 3: facet index and relation graph ---------------------------
# These need PyYAML. If it is missing, say so once rather than blocking the
# commit -- a missing local dependency should not make the repo uncommittable.
if python3 -c "import yaml" 2>/dev/null; then
  if ! python3 scripts/build_index.py >/dev/null; then
    fail "scripts/build_index.py failed (CI would fail on the same input)." \
         "python3 scripts/build_index.py   # then read the error above"
  fi
  if ! python3 scripts/check_relations.py; then
    fail "the relation graph is inconsistent (e.g. a relation pointing at a removed statement)." \
         "python3 scripts/check_relations.py   # then fix the offending relations: block"
  fi
else
  echo "pre-commit: note -- PyYAML not installed, so build_index.py and" >&2
  echo "  check_relations.py were skipped (CI still runs them)." >&2
  echo "  Install with: pip install -r requirements.txt" >&2
fi

exit 0
