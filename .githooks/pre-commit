#!/usr/bin/env bash
#
# Runs the cheap CI gates from .github/workflows/publish.yml before the commit
# is made, so a stale generated field fails here instead of failing every push
# afterwards.
#
# Why this exists: editing prose inside a `## Statement` block changes the text
# `scripts/status_badge.py` hashes into `statement_sha`. If the field is not
# regenerated, `--check` fails, and because that step gates the whole publish
# job, *every* subsequent push fails too -- not just the one that caused it.
# That happened on 2026-08-15 and blocked the site deploy for ~25 commits.
#
# Enable (once per clone):
#
#     git config core.hooksPath .githooks
#
# Bypass a single commit with `git commit --no-verify`.

set -uo pipefail

root="$(git rev-parse --show-toplevel)" || exit 0
cd "$root" || exit 0

# Only bother when the commit touches content these gates actually read.
# Nothing relevant staged (a .scss/.md-only commit) -> stay silent. The
# functionality fragments are in here because an edit to one of them is
# precisely what puts a page's interface box out of date.
if ! git diff --cached --name-only --diff-filter=ACMR \
     | grep -qE '^(c|p|papers)/|\.qmd$|^scripts/|^_templates/|^surveys/uc-for-gamers/latex/'; then
  exit 0
fi

fail() {
  echo ""
  echo "pre-commit: $1" >&2
  echo "" >&2
  echo "  Fix, stage the result, and commit again:" >&2
  echo "    $2" >&2
  echo "" >&2
  echo "  To commit anyway: git commit --no-verify" >&2
  echo "" >&2
  exit 1
}

# --- gate 1: statement schema and badges -------------------------------------
# stdlib-only, so this one always runs.
if ! python3 scripts/status_badge.py --check c papers; then
  fail "statement schema/badge data is stale (CI gate 'status_badge.py --check c papers' would fail)." \
       "python3 scripts/status_badge.py"
fi

# --- gate 2: UC interface boxes against their LaTeX --------------------------
# Also stdlib-only. Catches the same class of failure as gate 1 -- generated
# content that no longer matches the source it was generated from -- for the
# functionality boxes, where the usual cause is a line added to the .tex
# leaving every later <ol start="N"> on the page off by one.
if ! python3 scripts/artifact_manifest.py --check >/dev/null 2>&1; then
  python3 scripts/artifact_manifest.py --check >&2
  echo "pre-commit: a generated artifact no longer matches its LaTeX source." >&2
  exit 1
fi

if ! python3 scripts/gen_interface.py --check >/dev/null; then
  python3 scripts/gen_interface.py --check >&2
  fail "a UC interface box is not what its .tex fragment produces." \
       "python3 scripts/gen_interface.py"
fi

if ! python3 scripts/tab_structure.py --check >/dev/null; then
  python3 scripts/tab_structure.py --check >&2
  fail "a statement page's tabs are not the canonical set." \
       "python3 scripts/tab_structure.py   # then read the FAIL lines above"
fi

# --- gates 3 and 4: facet index and relation graph ---------------------------
# These need PyYAML. If it is missing, say so once rather than blocking the
# commit -- a missing local dependency should not make the repo uncommittable.
if python3 -c "import yaml" 2>/dev/null; then
  if ! python3 scripts/build_index.py >/dev/null; then
    fail "scripts/build_index.py failed (CI would fail on the same input)." \
         "python3 scripts/build_index.py   # then read the error above"
  fi
  if ! python3 scripts/check_relations.py; then
    fail "the relation graph is inconsistent (e.g. a relation pointing at a removed statement)." \
         "python3 scripts/check_relations.py   # then fix the offending relations: block"
  fi
  if ! python3 scripts/gen_topics.py --check >/dev/null; then
    fail "a topic page, the tag-cloud overview, or a statement's topic chips are stale." \
         "python3 scripts/gen_topics.py   # run build_index.py first if topics: changed"
  fi
else
  echo "pre-commit: note -- PyYAML not installed, so build_index.py," >&2
  echo "  check_relations.py and gen_topics.py were skipped (CI still runs them)." >&2
  echo "  Install with: pip install -r requirements.txt" >&2
fi

# --- gate 5: draft links ------------------------------------------------------
# stdlib-only. Only fails on a `draft:` field naming a folder that is not
# there, which is a typo caught best at the moment it is typed. Unpromoted
# drafts are reported by the same script and never block anything.
if ! python3 scripts/draft_status.py --check >/dev/null 2>&1; then
  python3 scripts/draft_status.py --check >&2
  fail "a c/ page's draft: field does not match latex/conjectures/." \
       "python3 scripts/draft_status.py   # then fix the draft: field"
fi

exit 0
