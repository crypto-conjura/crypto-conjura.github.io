_site/
.quarto/
.DS_Store

/.quarto/
**/*.quarto_ipynb

# LaTeX build byproducts (in /latex/ drafts and elsewhere) — never hand-edited, safe to regenerate.
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

__pycache__/

# Generated by scripts/build_index.py -- regenerated by CI before every
# render, never hand-edited or committed. Run the script locally before
# `quarto preview` if you need the facet listings to populate.
/_generated/
/conjura.json

# Personal scratch notes, never meant for the repo.
/local.lua

# Screenshots of definitions as printed in the source papers, written into an
# entry's own folder by scripts/uc_source.py as evidence a reviewer can hold
# beside the transcription. A figure from a Springer or IEEE proceedings
# version is the publisher's, so it stays out of the repository and off the
# public site; _src/sources.json *is* committed and records the URL, revision
# and page, so `python3 scripts/uc_source.py <id>` reproduces them exactly.
uc/**/_src/*.png
uc/**/_src/*.ps

# Lean/Lake build output and fetched dependencies (c/<id>/lean/.lake is ~7 GB
# of Mathlib). lake-manifest.json and lean-toolchain are committed, so
# `lake build` reconstructs this exactly.
.lake/

# The harvester's working area, whole: papers dropped into the inbox, the same
# papers after scripts/harvest_conjectures.py has read them, and the log of
# what was read. The papers are other people's publications -- a Springer,
# IEEE or ACM PDF is the publisher's, and even an ePrint posting is the
# authors' to distribute -- and /latex/ is tracked and public, so
# redistributing them here is not ours to do. The rest is one machine's record
# of its own runs, which is local by the same logic. Nothing is lost: the
# script recreates the folder when it runs, and each conjecture folder's
# harvest.json and SOURCE.md record the paper's title, identifier and sha256
# alongside every quote and its page, so a run is reproducible without it.
/latex/harvest/

# Wrangler's local state, written by `wrangler deploy` next to wrangler.jsonc.
# Nothing in it is shared: it caches this machine's uploads and auth.
/.wrangler/
/.lake

# tests/visual/ is a dev-only Playwright harness for CSS refactors, never
# part of the site build. node_modules and per-run scratch are excluded;
# the spec, config, and the committed baseline PNGs under
# specs/theme.spec.js-snapshots/ are the actual reviewable artifacts.
tests/visual/node_modules/
tests/visual/test-results/
tests/visual/playwright-report/
tests/visual/results.json
