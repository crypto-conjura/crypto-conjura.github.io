# chktex configuration for this conjecture. Run from this directory:
#
#     chktex -q -l .chktexrc statement.tex
#
# Two warnings are suppressed, checked hit by hit on 24 August 2026
# rather than assumed, each with a 100% false-positive rate here:
#
#   13  "Intersentence spacing (`\@') should perhaps be used." The one
#       hit is the colon inside a quoted paper title
#       (``Key-homomorphic computations for RAM: Fully succinct
#       randomised encodings and more''), where chktex mistakes the
#       capitalized acronym before the colon for an abbreviation ending
#       a sentence. It is a title, reproduced as printed; there is no
#       sentence boundary to mark.
#   38  "You should not use punctuation in front of quotes." The one
#       hit is the final character of a sentence quoted verbatim from
#       the source paper. The punctuation belongs to the quoted text,
#       so it stays inside the quotation marks; moving it out would
#       misquote.
#
# Everything else stays on. As of 24 August 2026 the file is clean under
# this config and `lacheck statement.tex` is silent.

CmdLine
{
    -n13
    -n38
}
