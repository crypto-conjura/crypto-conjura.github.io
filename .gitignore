_site/
.quarto/
.DS_Store

/.quarto/
**/*.quarto_ipynb

# LaTeX build byproducts (in /latex/ drafts and elsewhere) — never hand-edited, safe to regenerate.
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

__pycache__/

# Generated by scripts/build_index.py -- regenerated by CI before every
# render, never hand-edited or committed. Run the script locally before
# `quarto preview` if you need the facet listings to populate.
/_generated/
/conjura.json

# Personal scratch notes, never meant for the repo.
/local.lua

# Screenshots of definitions as printed in the source papers, written into an
# entry's own folder by scripts/uc_source.py as evidence a reviewer can hold
# beside the transcription. A figure from a Springer or IEEE proceedings
# version is the publisher's, so it stays out of the repository and off the
# public site; _src/sources.json *is* committed and records the URL, revision
# and page, so `python3 scripts/uc_source.py <id>` reproduces them exactly.
uc/**/_src/*.png
uc/**/_src/*.ps

# Lean/Lake build output and fetched dependencies (c/<id>/lean/.lake is ~7 GB
# of Mathlib). lake-manifest.json and lean-toolchain are committed, so
# `lake build` reconstructs this exactly.
.lake/
