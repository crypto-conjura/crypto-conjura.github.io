%% ucgamers.sty -- the notation, code-listing and box machinery of
%% *UC for Gamers*, factored out of main.tex so that a single interface
%% definition can live in one file and be read by two consumers: the book
%% itself (via \input from main.tex) and scripts/gen_interface.py, which
%% renders the same file to the HTML on its encyclopedia page.
%%
%% Load it where the notation block used to sit -- after xcolor, tcolorbox,
%% algpseudocode, multicol and the palette, all of which it needs and none
%% of which it reorders. The \RequirePackage lines below are for the
%% standalone case (functionalities/preview.tex); inside main.tex they are
%% no-ops, since every one of them is already loaded by then.
%%
%% What is here is exactly what an \begin{interface} block depends on. Two
%% rules keep it that way, and they are not cosmetic -- the generator reads
%% this file to learn what the notation macros mean:
%%   1. A notation macro belongs here, not in main.tex, if a code box can
%%      mention it. The generator expands \newcommand definitions found in
%%      this file and knows nothing of any defined elsewhere.
%%   2. If a macro's expansion is not valid MathJax (\op is \textsc, which
%%      MathJax has no font for), the generator needs an override for it in
%%      MACRO_OVERRIDES. Adding such a macro here without the override is
%%      how a box silently stops rendering on the web.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ucgamers}[2026/08/16 UC for Gamers notation and code boxes]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{xcolor}
\RequirePackage{algpseudocode}
\RequirePackage{multicol}
\RequirePackage[most]{tcolorbox}

%% The palette, for the standalone case only. main.tex defines these before
%% loading us, and \providecolor leaves an existing definition alone -- so
%% the book's colours stay the book's, and a fragment compiled on its own
%% still gets the right ones.
\providecolor{accent}{HTML}{C8791A}
\providecolor{accentsoft}{HTML}{A8630F}
\providecolor{boxrule}{HTML}{E0A85C}
\providecolor{boxtint}{HTML}{F6E2C4}
\providecolor{boxback}{HTML}{FDF6EC}
\providecolor{boxtitle}{HTML}{7A4A0C}
\providecolor{proctint}{HTML}{EFEAE2}
\providecolor{procback}{HTML}{F8F6F3}
\providecolor{procrule}{HTML}{B9A98F}
\providecolor{commenttint}{HTML}{8A8378}

