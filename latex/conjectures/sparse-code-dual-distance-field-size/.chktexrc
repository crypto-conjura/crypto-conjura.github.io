# chktex configuration for this conjecture. Run from this directory:
#
#     chktex -q -l .chktexrc statement.tex
#
# Two warnings are suppressed, checked hit by hit on 23 August 2026
# rather than assumed, with a 100% false-positive rate here:
#
#   3   "You should enclose the previous parenthesis with braces." Fires
#       on $(q_{w})^{k}$ and on $(p-1)^{w}$ in the two bound definitions
#       and in the remarks that discuss them, where in every case the
#       exponent attaches to the bracketed group exactly as intended.
#
#   38  "You should not use punctuation in front of quotes." Every hit is
#       the final character of a sentence quoted verbatim from the source
#       paper. The punctuation belongs to the quoted text, so it stays
#       inside the quotation marks; moving it out would misquote.
#
# Everything else stays on. As of 23 August 2026 the file is clean under
# this config and `lacheck statement.tex` is silent.

CmdLine
{
    -n3
    -n38
}
